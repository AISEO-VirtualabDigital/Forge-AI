# ============================================================
# Forge AI — .gitignore
# Thoroughly excludes local build artifacts, dependencies,
# environment secrets, and local SQLite databases.
# ============================================================

# --- Dependencies ---
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Testing ---
/coverage
*.lcov

# --- Next.js build artifacts ---
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# --- Production standalone ---
# (Next.js standalone output lives under .next/standalone — covered above)

# --- Vercel ---
.vercel

# --- Environment files (NEVER commit) ---
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
.env*.local

# --- Local SQLite databases (NEVER commit) ---
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.sqlite3
/db/*.db
/db/*.db-journal
/prisma/*.db
/prisma/*.db-journal

# --- Prisma generated client (regenerated on install/build) ---
# NOTE: @prisma/client is an npm package; the generated client lives in
# node_modules/.prisma which is already ignored by node_modules/.
# Keep migrations tracked — only ignore local dev DB snapshots.

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
dev.out.log
server.log

# --- OS / editor ---
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# --- Python caches (push_to_github.py etc.) ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Misc local ---
.claude
.z-ai-config
.zscripts/
local-*
prompt
test
/skills/
/agent-ctx/
/download/
/mini-services/*/
